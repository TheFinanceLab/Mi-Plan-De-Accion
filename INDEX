https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&family=Carlito:wght@400;700&display=swap" rel="stylesheet"> <style> :root{   --bg:#F6F3EE; --paper:#FFFDF9; --ink:#1F3D34; --muted:#4A6B5D; --line:#DCD7CC;   --green:#CBA35A; --green-soft:#E4ECE6; --amber:#CBA35A; --amber-soft:#F3EAD8; --field:#F1EDE5;   box-sizing:border-box;   padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px); } @media (prefers-color-scheme: dark){   :root:not([data-theme="light"]){     --bg:#142A23; --paper:#1F3D34; --ink:#F6F3EE; --muted:#A7BFAF; --line:#2F5246;     --green:#CBA35A; --green-soft:#2A4A3F; --amber:#CBA35A; --amber-soft:#3A3424; --field:#27493E;   } } :root[data-theme="dark"]{   --bg:#142A23; --paper:#1F3D34; --ink:#F6F3EE; --muted:#A7BFAF; --line:#2F5246;   --green:#CBA35A; --green-soft:#2A4A3F; --amber:#CBA35A; --amber-soft:#3A3424; --field:#27493E; } *,*::before,*::after{box-sizing:inherit} html{scroll-padding-top:env(safe-area-inset-top,0px)} body{margin:0;background:var(--bg);color:var(--ink);font-family:Carlito,Calibri,system-ui,-apple-system,"Segoe UI",sans-serif;font-size:1.125rem;line-height:1.55} h1,h2,h3{font-family:Poppins,"Montserrat",system-ui,sans-serif;line-height:1.15;margin:0} header{border-top:6px solid var(--green)} .wrap{max-width:720px;margin:0 auto;padding:1.5rem 1.1rem 3rem} header{padding:1.5rem 0 1.75rem} header h1{font-size:clamp(2.2rem,8vw,3.2rem);font-weight:300;letter-spacing:-.01em} header p{color:var(--muted);margin:.6rem 0 0;max-width:34em} section{background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:1.4rem 1.2rem;margin-bottom:1.1rem} section h2{font-size:1.4rem;font-weight:500;margin-bottom:.3rem} .step{display:inline-grid;place-items:center;width:1.9rem;height:1.9rem;border-radius:50%;background:var(--ink);color:#CBA35A;font-family:Poppins,sans-serif;font-weight:500;font-size:1rem;margin-right:.5rem;vertical-align:middle} .hint{color:var(--muted);font-size:.95rem;margin:0 0 1rem} label{display:block;font-weight:700;font-size:.95rem;margin-bottom:.35rem} .field{margin-bottom:1rem} input,textarea{width:100%;font:inherit;color:var(--ink);background:var(--field);border:1.5px solid transparent;border-radius:10px;padding:.65rem .8rem} textarea{resize:vertical;min-height:4.2rem} input:focus-visible,textarea:focus-visible,button:focus-visible{outline:3px solid var(--green);outline-offset:2px} .grid2{display:grid;grid-template-columns:1fr 1fr;gap:.9rem} .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:.9rem} @media (max-width:520px){.grid3{grid-template-columns:1fr}} .suffix{position:relative} .suffix span{position:absolute;right:.8rem;top:50%;transform:translateY(-50%);color:var(--muted);pointer-events:none} .suffix input{padding-right:2.6rem} /* The ladder: the one bold element */ .ladder{margin-top:.4rem;display:flex;flex-direction:column;align-items:center;gap:0} .rung{width:100%;border-radius:14px;padding:1rem 1.1rem;display:flex;align-items:center;justify-content:space-between;gap:1rem} .rung .n{font-family:Poppins,sans-serif;font-weight:300;font-size:clamp(2.2rem,9vw,3rem);line-height:1;font-variant-numeric:tabular-nums} .rung .t{text-align:right} .rung .t b{display:block;font-size:1.05rem} .rung .t small{color:var(--muted);font-size:.9rem} .r1{background:#1F3D34;color:#F6F3EE;width:62%;border:1px solid #CBA35A} .r1 .n{color:#CBA35A} .r1 .t small{color:inherit;opacity:.75} .r2{background:var(--green-soft);width:81%} .r3{background:var(--amber-soft);width:100%} .arrow{color:var(--muted);font-size:.85rem;padding:.35rem 0} @media (max-width:520px){.r1,.r2{width:100%}} .perweek{display:grid;grid-template-columns:repeat(4,1fr);gap:.6rem;margin-top:1.1rem} @media (max-width:560px){.perweek{grid-template-columns:1fr 1fr}} .perweek .today{background:var(--ink);border-color:var(--ink)} .perweek .today strong{color:#CBA35A}.perweek .today span{color:var(--bg)} .chips{display:grid;grid-template-columns:repeat(4,1fr);gap:.5rem;margin-bottom:1rem} @media (max-width:560px){.chips{grid-template-columns:1fr 1fr}} button.chip{background:var(--field);color:var(--ink);border:1.5px solid var(--line);border-radius:12px;padding:.6rem .7rem;text-align:left;font-weight:400;line-height:1.25} .chip b{display:block;font-family:Poppins,sans-serif;font-size:1.5rem;font-weight:400} .chip span{font-size:.85rem;color:var(--muted)} button.chip[aria-pressed="true"]{background:var(--paper);border-color:#CBA35A;box-shadow:inset 0 0 0 1px #CBA35A} .done{background:var(--green-soft);border-radius:12px;padding:.8rem 1rem;font-weight:700;margin:1rem 0 0} .next{color:var(--muted);font-weight:400!important} .perweek div{border:1.5px solid var(--line);border-radius:12px;padding:.7rem;text-align:center} .perweek strong{display:block;font-family:Poppins,sans-serif;font-size:1.6rem;font-weight:400} .perweek span{font-size:.85rem;color:var(--muted)} /* Tracker */ .overall{margin-bottom:1.2rem} .bar{height:14px;background:var(--field);border-radius:99px;overflow:hidden} .bar i{display:block;height:100%;background:var(--green);border-radius:99px;transition:width .4s ease} .overall p{margin:.45rem 0 0;font-weight:700} .week{border-top:1px solid var(--line);padding:1rem 0 .4rem} .week h3{font-size:1.15rem;margin-bottom:.7rem;display:flex;justify-content:space-between;align-items:baseline} .week h3 small{font-family:Carlito,Calibri,sans-serif;font-weight:400;font-size:.85rem;color:var(--muted)} .wgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:.6rem} @media (max-width:560px){.wgrid{grid-template-columns:1fr 1fr}} .wgrid label{font-size:.85rem;font-weight:400;color:var(--muted)} .wgrid input{text-align:center;font-weight:700} .wgrid .goal{font-size:.8rem;color:var(--muted);margin-top:.25rem;text-align:center} .wgrid .ok{color:var(--ink);font-weight:700} .sum{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;text-align:center;margin-top:1rem} .sum div{background:var(--field);border-radius:12px;padding:.6rem .3rem} .sum strong{display:block;font-family:Poppins,sans-serif;font-weight:400;font-size:1.35rem;color:var(--ink)} .sum span{font-size:.8rem;color:var(--muted)} .cal{display:grid;grid-template-columns:repeat(6,1fr);gap:.35rem;margin:.7rem 0 .5rem} .cal button{background:var(--field);color:var(--ink);border:1.5px solid transparent;border-radius:10px;padding:.45rem 0;font-weight:400;display:flex;flex-direction:column;align-items:center;line-height:1.15;min-height:3rem} .cal button b{font-family:Poppins,sans-serif;font-weight:500;font-size:1rem} .cal button small{font-size:.66rem;color:var(--muted)} .cal button.part{background:var(--amber-soft)} .cal button.ok{background:#1F3D34;color:#CBA35A} .cal button.ok small{color:#A7BFAF} .cal button.today{border-color:#CBA35A} .cal button[aria-pressed="true"]{box-shadow:0 0 0 2.5px var(--ink)} .months{display:flex;gap:.4rem;overflow-x:auto;margin-top:1.1rem;padding-bottom:.2rem} .months button{white-space:nowrap;background:var(--field);color:var(--ink);border-color:var(--line);font-weight:400;padding:.45rem .9rem;font-size:.95rem} .months button[aria-pressed="true"]{background:var(--ink);color:var(--paper);border-color:var(--ink);font-weight:700} .msum{margin:.6rem 0 0;font-size:.92rem;color:var(--muted)} .legend{display:flex;flex-wrap:wrap;gap:.9rem;font-size:.82rem;color:var(--muted);margin-bottom:1rem} .legend i{display:inline-block;width:.8rem;height:.8rem;border-radius:3px;vertical-align:-1px;margin-right:.3rem} .daypanel{border-top:1px solid var(--line);padding-top:1rem} .dayhead{display:flex;justify-content:space-between;align-items:center;gap:.5rem;margin-bottom:.3rem} .dayhead h3{font-size:1.25rem;font-weight:500} .dayhead button{padding:.35rem .75rem;font-size:.9rem} .daygoal{color:var(--muted);font-size:.92rem;margin:0 0 .8rem} .daypanel textarea{min-height:3.6rem} .actions{display:flex;gap:.7rem;flex-wrap:wrap;margin-top:.5rem} button{font:inherit;font-weight:700;border-radius:10px;padding:.7rem 1.1rem;cursor:pointer;border:1.5px solid var(--ink);background:var(--ink);color:var(--paper)} button.ghost{background:transparent;color:var(--ink)} .note{font-size:.9rem;color:var(--muted);margin-top:1.2rem} @media (prefers-reduced-motion:reduce){.bar i{transition:none}} @media print{   body{background:#fff;color:#000}   section{break-inside:avoid;border-color:#ccc}   .actions{display:none} } </style> </head> <body> <div class="wrap">   <header>     <h1>Mi plan de acción</h1>     <p>Pon tu meta, ajusta tus porcentajes y descubre exactamente cuánta actividad necesitas. Luego anota tu avance cada semana.</p>   </header>   <section>     <h2><span class="step">1</span>Mi meta</h2>     <p class="hint">Escribe cuántas membresías tienes hoy y a cuántas quieres llegar. Cuentan clientes y socios.</p>     <div class="field">       <label for="nombre">Mi nombre</label>       <input id="nombre" type="text" placeholder="Escribe tu nombre">     </div>     <div class="grid2">       <div class="field">         <label for="actuales">Membresías que ya tengo</label>         <input id="actuales" type="number" min="0" inputmode="numeric" value="0">       </div>       <div class="field">         <label for="meta">Mi meta (total de membresías)</label>         <input id="meta" type="number" min="1" inputmode="numeric" value="6">       </div>       <div class="field">         <label for="dias">En cuántos días</label>         <input id="dias" type="number" min="7" inputmode="numeric" value="30">       </div>       <div class="field">         <label for="diasSem">Días que trabajo a la semana</label>         <input id="diasSem" type="number" min="1" max="7" inputmode="numeric" value="5">       </div>     </div>     <div class="field">       <label for="porque">Mi porqué</label>       <textarea id="porque" placeholder="¿Para qué quiero lograr esta meta?"></textarea>     </div>   </section>   <section>     <h2><span class="step">2</span>Mis números</h2>     <p class="hint">Si todavía no conoces tus porcentajes, empieza con estos y ajústalos cuando tengas datos reales.</p>     <div class="grid3">       <div class="field">         <label for="cierre">Presentaciones que cierran</label>         <div class="suffix"><input id="cierre" type="number" min="1" max="100" inputmode="numeric" value="30"><span>%</span></div>       </div>       <div class="field">         <label for="conv">Llamadas que llegan a presentación</label>         <div class="suffix"><input id="conv" type="number" min="1" max="100" inputmode="numeric" value="50"><span>%</span></div>       </div>       <div class="field">         <label for="pubs">Publicaciones en redes al día</label>         <input id="pubs" type="number" min="0" inputmode="numeric" value="1">       </div>     </div>     <div class="ladder" aria-live="polite">       <div class="rung r1"><span class="n" id="oMeta">6</span><span class="t"><b>membresías nuevas</b><small id="sMeta">para llegar a 6</small></span></div>       <div class="arrow" id="aCierre">necesito</div>       <div class="rung r2"><span class="n" id="oPres">20</span><span class="t"><b>presentaciones</b><small id="sPres">cerrando el 30%</small></span></div>       <div class="arrow">y para eso</div>       <div class="rung r3"><span class="n" id="oConv">40</span><span class="t"><b>llamadas o conversaciones</b><small id="sConv">la mitad llega a presentación</small></span></div>     </div>     <p class="done" id="done" hidden>¡Ya alcanzaste esta meta! Elige tu siguiente escalón.</p>     <div class="perweek">       <div class="today"><strong id="dConv">2</strong><span>llamadas por día de trabajo</span></div>       <div><strong id="wConv">8</strong><span>llamadas por semana</span></div>       <div><strong id="wPres">4</strong><span>presentaciones por semana</span></div>       <div><strong id="wPubs">7</strong><span>publicaciones por semana</span></div>     </div>   </section>   <section>     <h2><span class="step">3</span>Mis compromisos</h2>     <p class="hint">Tres actividades que voy a hacer cada semana, pase lo que pase.</p>     <div class="field"><input id="c1" type="text" placeholder="Ej.: 2 llamadas cada día de lunes a viernes"></div>     <div class="field"><input id="c2" type="text" placeholder="Ej.: publicar un testimonio o tip de crédito diario"></div>     <div class="field"><input id="c3" type="text" placeholder="Ej.: dar seguimiento a mis clientes cada viernes"></div>     <div class="field">       <label for="socio">Mi compañero de rendición de cuentas</label>       <input id="socio" type="text" placeholder="¿Quién me va a preguntar cómo voy?">     </div>   </section>   <section>     <h2><span class="step">4</span>Mi avance</h2>     <p class="hint">Documenta cada día. Elige el mes y toca un día para anotar o revisar lo que hiciste. Cuando termines, empieza un nuevo ciclo y úsala otra vez.</p>     <div class="overall">       <div class="bar"><i id="barFill" style="width:0%"></i></div>       <p id="overallTxt">0 de 6 membresías</p>       <p class="next" id="nextTxt"></p>     </div>     <div class="sum">       <div><strong id="tLlam">0</strong><span id="tLlamS">llamadas</span></div>       <div><strong id="tPres">0</strong><span id="tPresS">presentaciones</span></div>       <div><strong id="tOk">0</strong><span>días cumplidos</span></div>     </div>     <div class="months" id="months" role="group" aria-label="Meses del plan"></div>     <p class="msum" id="msum"></p>     <div class="cal" id="cal" role="group" aria-label="Días del mes"></div>     <div class="legend"><span><i style="background:#1F3D34"></i>Meta cumplida</span><span><i style="background:var(--amber-soft)"></i>Con avance</span></div>     <div class="daypanel" id="dayPanel">       <div class="dayhead"><button type="button" class="ghost" id="prevD" aria-label="Día anterior">‹</button><h3 id="dTitle">Día 1</h3><button type="button" class="ghost" id="nextD" aria-label="Día siguiente">›</button></div>       <p class="daygoal" id="dGoal"></p>       <div class="wgrid">         <div><label for="d_llamadas">Llamadas</label><input id="d_llamadas" data-d="llamadas" type="number" min="0" inputmode="numeric"></div>         <div><label for="d_pres">Presentaciones</label><input id="d_pres" data-d="pres" type="number" min="0" inputmode="numeric"></div>         <div><label for="d_cierres">Membresías nuevas</label><input id="d_cierres" data-d="cierres" type="number" min="0" inputmode="numeric"></div>         <div><label for="d_pubs">Publicaciones</label><input id="d_pubs" data-d="pubs" type="number" min="0" inputmode="numeric"></div>       </div>       <div class="field" style="margin-top:.9rem"><label for="d_contactos">¿Con quién hablé hoy?</label><textarea id="d_contactos" data-d="contactos" placeholder="Nombres y próximo paso con cada uno"></textarea></div>       <div class="field"><label for="d_notas">Logros y aprendizajes</label><textarea id="d_notas" data-d="notas" placeholder="¿Qué funcionó? ¿Qué voy a mejorar mañana?"></textarea></div>     </div>     <div class="actions">       <button type="button" onclick="window.print()">Imprimir mi plan</button>       <button type="button" class="ghost" id="ciclo">Empezar un nuevo ciclo</button>       <button type="button" class="ghost" id="reset">Borrar todo</button>     </div>     <p class="note">Tus datos se guardan solo en este dispositivo. Estos cálculos son una guía de actividad basada en tus porcentajes; no son una promesa de resultados ni de ingresos.</p>   </section> </div> <script> (function(){   var KEY='plan-accion-v1';   var STEPS=[[4,'cubres tu mensualidad'],[6,'activas tu ingreso semanal'],[12,''],[36,'Business Director']];   var ids=['nombre','actuales','meta','dias','diasSem','porque','cierre','conv','pubs','c1','c2','c3','socio'];   var state={fields:{},weeks:{},days:{}};   var sel=null;   function isoD(d){return d.getFullYear()+'-'+('0'+(d.getMonth()+1)).slice(-2)+'-'+('0'+d.getDate()).slice(-2);}   var TODAY=isoD(new Date());   var MES=['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];   function load(){try{var s=localStorage.getItem(KEY);if(s){var p=JSON.parse(s);if(p&&p.fields)state=p;}}catch(e){}     state.days=state.days||{};}   function save(){try{localStorage.setItem(KEY,JSON.stringify(state));}catch(e){}}   function num(id,def){var v=parseFloat(document.getElementById(id).value);return isFinite(v)&&v>0?v:def;}   function $(id){return document.getElementById(id);}   var cols=[['llamadas','Llamadas'],['pres','Presentaciones'],['cierres','Membresías'],['pubs','Publicaciones']];   function calc(){     var total=Math.ceil(num('meta',6)), dias=Math.max(7,Math.ceil(num('dias',30)));     var av=parseFloat($('actuales').value); var actuales=isFinite(av)&&av>0?Math.floor(av):0;     var ds=Math.min(7,Math.max(1,Math.round(num('diasSem',5))));     var meta=Math.max(0,total-actuales);     var cierre=Math.min(100,num('cierre',30))/100, conv=Math.min(100,num('conv',50))/100;     var pubsV=parseFloat($('pubs').value); var pubs=isFinite(pubsV)&&pubsV>=0?pubsV:0;     var pres=Math.ceil(meta/cierre), llam=Math.ceil(pres/conv), semanas=Math.ceil(dias/7);     return {total:total,actuales:actuales,ds:ds,meta:meta,dias:dias,semanas:semanas,pres:pres,llam:llam,cierre:cierre,conv:conv,       dL:Math.ceil(Math.ceil(llam/semanas)/ds),dP:Math.ceil(Math.ceil(pres/semanas)/ds),dS:pubs,       w:{llamadas:Math.ceil(llam/semanas),pres:Math.ceil(pres/semanas),cierres:Math.ceil(meta/semanas),pubs:Math.ceil(pubs*7)}};   }   function render(){     var c=calc();     $('oMeta').textContent=c.meta; $('oPres').textContent=c.pres; $('oConv').textContent=c.llam;     $('sPres').textContent='cerrando el '+Math.round(c.cierre*100)+'%';     var cp=Math.round(c.conv*100);     $('sConv').textContent=cp===50?'la mitad llega a presentación':cp+'% llega a presentación';     $('sMeta').textContent='para llegar a '+c.total+(c.actuales?' (ya tienes '+c.actuales+')':'');     $('done').hidden=c.meta>0;     $('dConv').textContent=Math.ceil(c.w.llamadas/c.ds);     document.querySelectorAll('.chip').forEach(function(b){b.setAttribute('aria-pressed',String(Number(b.dataset.v)===c.total));});     $('wConv').textContent=c.w.llamadas; $('wPres').textContent=c.w.pres; $('wPubs').textContent=c.w.pubs;     renderCal(c); renderDay(c);     updateOverall(c);   }   function updateOverall(c){     var total=0,tl=0,tp=0,ok=0;     for(var i=1;i<=c.dias;i++){var d=state.days[i];if(!d)continue;total+=Number(d.cierres)||0;tl+=Number(d.llamadas)||0;tp+=Number(d.pres)||0;if((Number(d.llamadas)||0)>=c.dL&&c.dL>0)ok++;}     $('tLlam').textContent=tl; $('tLlamS').textContent='llamadas de '+c.llam;     $('tPres').textContent=tp; $('tPresS').textContent='presentaciones de '+c.pres;     $('tOk').textContent=ok;     var now=c.actuales+total;     var pct=Math.min(100,Math.round(now/c.total*100));     $('barFill').style.width=pct+'%';     $('overallTxt').textContent=now+' de '+c.total+' membresías'+(now>=c.total?' · ¡Lo lograste!':'');     var nx=null; for(var j=0;j<STEPS.length;j++){if(STEPS[j][0]>now){nx=STEPS[j];break;}}     $('nextTxt').textContent=nx?'Próximo escalón: '+nx[0]+(nx[1]?' ('+nx[1]+')':'')+'. Te faltan '+(nx[0]-now)+'.':'';   }   function status(i,c){var d=state.days[i];if(!d)return '';var l=Number(d.llamadas)||0;if(c.dL>0&&l>=c.dL)return 'ok';     for(var k in d){if(d[k]!==''&&d[k]!==0&&d[k]!=null)return 'part';}return '';}   function mOf(i){return Math.ceil(i/30);}   function renderCal(c){     if(sel===null||sel>c.dias){sel=1;for(var q=1;q<=c.dias;q++){if(status(q,c)!=='')sel=Math.min(c.dias,q+1);}}     var nm=Math.ceil(c.dias/30),cm=mOf(sel),mh='';     for(var m=1;m<=nm;m++)mh+='<button type="button" data-m="'+m+'" aria-pressed="'+(m===cm)+'">Mes '+m+'</button>';     $('months').innerHTML=mh; $('months').hidden=nm<2;     var a=(cm-1)*30+1,b=Math.min(cm*30,c.dias),html='',ok=0;     for(var i=a;i<=b;i++){var st=status(i,c);if(st==='ok')ok++;       html+='<button type="button" data-day="'+i+'" class="'+st+'" aria-pressed="'+(i===sel)+'" aria-label="Día '+(i-a+1)+'"><b>'+(i-a+1)+'</b></button>';}     $('cal').innerHTML=html;     $('msum').textContent=(nm>1?'Mes '+cm+': ':'')+ok+' de '+(b-a+1)+' días con la meta de llamadas cumplida.';   }   function renderDay(c){     var d=state.days[sel]||{},cm=mOf(sel),k=sel-(cm-1)*30;     $('dTitle').textContent=(Math.ceil(c.dias/30)>1?'Mes '+cm+' · ':'')+'Día '+k;     $('dGoal').textContent='Meta del día: '+c.dL+' llamadas, '+c.dP+' presentaciones y '+c.dS+' publicaciones.';     document.querySelectorAll('#dayPanel [data-d]').forEach(function(el){var v=d[el.dataset.d];el.value=(v===undefined||v===null)?'':v;});     $('prevD').disabled=sel<=1; $('nextD').disabled=sel>=c.dias;   }   load();   ids.forEach(function(id){     var el=$(id);     if(state.fields[id]!==undefined)el.value=state.fields[id];     el.addEventListener('input',function(){state.fields[id]=el.value;save();       if(['actuales','meta','dias','diasSem','cierre','conv','pubs'].indexOf(id)>-1)render();});   });   document.querySelectorAll('.chip').forEach(function(b){b.addEventListener('click',function(){     $('meta').value=b.dataset.v; state.fields.meta=b.dataset.v; save(); render();});});   $('months').addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;sel=(Number(b.dataset.m)-1)*30+1;var c=calc();renderCal(c);renderDay(c);});   $('ciclo').addEventListener('click',function(){     if(!confirm('Se borrará lo que anotaste día a día para empezar un ciclo nuevo. Tu meta y tus porcentajes se quedan. Recuerda actualizar tus membresías actuales.'))return;     state.days={}; sel=1; save(); render(); $('dayPanel').scrollIntoView({behavior:'smooth',block:'start'});   });   $('cal').addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;sel=Number(b.dataset.day);var c=calc();renderCal(c);renderDay(c);});   $('prevD').addEventListener('click',function(){if(sel>1){sel--;var c=calc();renderCal(c);renderDay(c);}});   $('nextD').addEventListener('click',function(){var c=calc();if(sel<c.dias){sel++;renderCal(c);renderDay(c);}});   $('dayPanel').addEventListener('input',function(e){var t=e.target,k=t.dataset.d;if(!k)return;     state.days[sel]=state.days[sel]||{};     state.days[sel][k]=t.type==='number'?(t.value===''?'':Number(t.value)):t.value; save();     var c=calc();renderCal(c);updateOverall(c);});   $('reset').addEventListener('click',function(){     if(!confirm('¿Borrar todos tus datos de este plan?'))return;     state={fields:{},weeks:{},days:{}}; sel=null; save();     ids.forEach(function(id){var el=$(id);el.value=el.defaultValue||'';});     render();   });   render(); })(); </script> </body> </html>
